{
  "exclude": ["node_modules"],
  // 编译器选项配置
  "compilerOptions": {
    // 禁用输出文件，仅检查类型。（1. 顶层文件不需要设置输出 2. 解决tsconfig文件报错问题）
    "noEmit": true,
    // 编译目标为 ES2015 (ES6)，确保广泛的浏览器兼容性
    "target": "ES2015",
    // 包含 DOM API 和最新 ES 特性的类型定义
    "lib": ["DOM", "ESNext"],
    // 允许编译 JavaScript 文件，支持渐进式迁移
    "allowJs": true,
    // 使用最新的 ES 模块语法 (import/export)
    "module": "ESNext",
    // 采用打包器友好的模块解析策略，兼容 Vite/Rollup
    "moduleResolution": "Bundler",
    // 允许 CommonJS 模块以 ES 模块方式导入
    "esModuleInterop": true,
    // 强制文件名大小写一致，防止跨平台问题
    "forceConsistentCasingInFileNames": true,
    // 生成 .d.ts 类型声明文件，组件库必须配置
    "declaration": true,
    // 支持直接导入 .json 文件
    "resolveJsonModule": true,
    // 跳过第三方库的类型检查，提升编译速度
    "skipLibCheck": true,
    // 启用严格类型检查模式
    "strict": true
  },
  // 提供 JSON Schema 校验，IDE 可给出智能提示
  "$schema": "https://json.schemastore.org/tsconfig",
  // 配置显示名称，便于在继承配置时识别
  "display": "Base"
}
