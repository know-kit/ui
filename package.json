{
  "name": "kno",
  "private": true,
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/know-kit/ui.git"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "commit": "HUSKY_ALLOW_COMMIT=1 czg",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changelog": "conventional-changelog -p conventionalcommits -i docs/UI_CHANGELOG.md -s",
    "changelog:first-release": "conventional-changelog -p conventionalcommits --first-release -i docs/UI_CHANGELOG.md -s",
    "changelog:preview": "conventional-changelog -p conventionalcommits --stdout",
    "prepare": "husky",
    "lint": "eslint --fix --cache",
    "lint:style": "stylelint \"packages/**/*.{css,tsx}\" \"apps/**/*.{css,tsx}\"",
    "test": "turbo run build && vitest",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions --no-must-find-files \"packages/**/*.{html,js,cjs,mjs,ts,tsx,css,scss,md}\" \"apps/**/*.{html,js,cjs,mjs,ts,tsx,css,scss,md}\""
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "catalog": "3.6.2",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "cspell": "10.0.1",
    "czg": "1.13.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.1.0",
    "postcss-styled-syntax": "0.7.2",
    "prettier": "3.9.5",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
